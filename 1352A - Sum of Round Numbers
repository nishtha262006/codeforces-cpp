#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int place = 1;
        int count = 0;
        int temp = n;

        while (temp > 0) {
            int digit = temp % 10;

            if (digit != 0)
                count++;

            temp /= 10;
        }

        cout << count << "\n";

        while (n > 0) {
            int digit = n % 10;

            if (digit != 0) {
                cout << digit * place << " ";
            }

            n /= 10;
            place *= 10;
        }

        cout << "\n";
    }

    return 0;
}
