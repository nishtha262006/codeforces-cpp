#include <iostream>
#include <vector>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, x;
        cin >> n >> x;

        vector<int> a(n);
        int sum = 0;

        for (int i = 0; i < n; i++) {
            cin >> a[i];
            sum += a[i];
        }

        if (sum % x != 0) {
            cout << n << "\n";
            continue;
        }

        int left = -1;
        int right = -1;

        for (int i = 0; i < n; i++) {
            if (a[i] % x != 0) {
                left = i;
                break;
            }
        }

        for (int i = n - 1; i >= 0; i--) {
            if (a[i] % x != 0) {
                right = i;
                break;
            }
        }

        if (left == -1) {
            cout << -1 << "\n";
        }
        else {
            int removeLeft = left + 1;
            int removeRight = n - right;

            cout << n - min(removeLeft, removeRight) << "\n";
        }
    }

    return 0;
}
