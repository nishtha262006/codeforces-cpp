
#include <iostream>
#include <string>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;
        cin >> n >> s;

        int left = 0;
        int right = n - 1;

        while (left < right && s[left] != s[right]) {
            left++;
            right--;
        }

        cout << right - left + 1 << '\n';
    }

    return 0;
}
