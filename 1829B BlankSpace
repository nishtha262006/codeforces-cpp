
#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        int current = 0;
        int maximum = 0;

        for (int i = 0; i < n; i++) {
            int x;
            cin >> x;

            if (x == 0) {
                current++;
            } else {
                current = 0;
            }

            maximum = max(maximum, current);
        }

        cout << maximum << '\n';
    }

    return 0;
}
