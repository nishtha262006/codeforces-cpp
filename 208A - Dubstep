#include <iostream>
#include <string>
#include <sstream>
using namespace std;

int main() {
    string s;
    cin >> s;

    while (s.find("WUB") != string::npos) {
        s.replace(s.find("WUB"), 3, " ");
    }

    stringstream ss(s);
    string word;
    bool first = true;

    while (ss >> word) {
        if (!first)
            cout << " ";

        cout << word;
        first = false;
    }

    return 0;
}
