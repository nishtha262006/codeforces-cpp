#include <iostream>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n, k;
        cin >> n >> k;

        if (k == n - 1) {
            cout << -1 << "\n";
            continue;
        }

        // Number of blocks we need
        k = n - k;

        int c0 = (n + 1) / 2;
        int c1 = n / 2;

        for (int i = 1; i <= k; i++) {

            if (i % 2 == 1) {
                // Last 0-block
                if (i + 2 > k) {
                    while (c0--)
                        cout << 0;
                }
                else {
                    cout << 0;
                    c0--;
                }
            }
            else {
                // Last 1-block
                if (i + 2 > k) {
                    while (c1--)
                        cout << 1;
                }
                else {
                    cout << 1;
                    c1--;
                }
            }
        }

        cout << "\n";
    }

    return 0;
}
