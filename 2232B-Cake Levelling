#include <iostream>
#include <vector>
#include <algorithm>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        cin >> n;

        vector<long long> a(n);

        for (int i = 0; i < n; i++) {
            cin >> a[i];
        }

        long long sum = 0;
        long long ans = a[0];

        for (int i = 0; i < n; i++) {
            sum += a[i];

            long long current = sum / (i + 1);

            ans = min(ans, current);

            cout << ans << " ";
        }

        cout << "\n";
    }

    return 0;
}
