#include <iostream>
#include <algorithm>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        long long a, b, c;
        cin >> a >> b >> c;

        long long x[3] = {a, b, c};

        sort(x, x + 3);

        cout << min(x[2] - x[0], x[1]) << "\n";
    }

    return 0;
}
