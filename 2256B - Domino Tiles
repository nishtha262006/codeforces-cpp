#include <iostream>
#include <string>
using namespace std;

int main() {
    int t;
    cin >> t;

    while (t--) {
        int n;
        string s;

        cin >> n >> s;

        int ans = 0;

        for (int first = 0; first <= 1; first++) {
            for (int second = 0; second <= 1; second++) {

                string cur(n, '0');

                cur[0] = char('0' + first);
                cur[1] = char('0' + second);

                for (int i = 2; i < n; i++) {
                    if (cur[i - 2] == '0')
                        cur[i] = '1';
                    else
                        cur[i] = '0';
                }

                bool valid = true;

                for (int i = 0; i < n; i++) {
                    if (s[i] != '?' && s[i] != cur[i]) {
                        valid = false;
                        break;
                    }
                }

                if (valid)
                    ans++;
            }
        }

        cout << ans << "\n";
    }

    return 0;
}
