#include<iostream>
using namespace std;
int main(){
    int n , m;
    cin>>n>>m;
    
    long long ans = 0;
    int current = 1;
    
    for(int i =0; i<m; i++){
        int next ;
        cin>>next;
        
        if(next>=current){
            ans+=next - current;
        }else{
            ans+=n-current +next;
        }
        current = next;
    }
    cout<<ans;
    return 0;
}
