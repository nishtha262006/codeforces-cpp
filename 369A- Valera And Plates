#include <iostream>
using namespace std;

int main() {
    int n, bowls, plates;
    cin >> n >> bowls >> plates;

    int ans = 0;

    for (int i = 0; i < n; i++) {
        int dish;
        cin >> dish;

        if (dish == 1) {
            if (bowls > 0) {
                bowls--;
            } else {
                ans++;
            }
        } else {
            if (plates > 0) {
                plates--;
            } else if (bowls > 0) {
                bowls--;
            } else {
                ans++;
            }
        }
    }

    cout << ans;
    return 0;
}
