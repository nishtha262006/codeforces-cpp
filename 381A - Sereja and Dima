#include <iostream>
#include <vector>
using namespace std;

int main() {
    int n;
    cin >> n;

    vector<int> a(n);

    for (int i = 0; i < n; i++)
        cin >> a[i];

    int left = 0;
    int right = n - 1;

    int sereja = 0;
    int dima = 0;

    for (int i = 0; i < n; i++) {
        int card;

        if (a[left] > a[right]) {
            card = a[left];
            left++;
        }
        else {
            card = a[right];
            right--;
        }

        if (i % 2 == 0)
            sereja += card;
        else
            dima += card;
    }

    cout << sereja << " " << dima;

    return 0;
}
