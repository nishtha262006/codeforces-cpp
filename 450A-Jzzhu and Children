#include<iostream>
using namespace std;
int main(){
    int n , m;
    cin>>n>>m;
    int maxTurns = 0;
    int answer = 0;
    for(int i =0; i<n;i++){
        int candles;
        cin>>candles;
        int turns = (candles +m -1)/m;
        if(turns>=maxTurns){
            maxTurns = turns;
            answer = i+1;
        }
    }
    cout<<answer;
    return 0 ;
    
