
#include <iostream>
#include <vector>
using namespace std;
 
int cnt[8];
 
int main() {
    int n;
    cin >> n;
 
    for (int i = 0; i < n; i++) {
        int x;
        cin >> x;
 
        if (x == 5 || x == 7) {
            cout << -1;
            return 0;
        }
 
        cnt[x]++;
    }
 
    vector<vector<int>> ans;
 
    while (cnt[1] && cnt[2] && cnt[4]) {
        ans.push_back({1, 2, 4});
        cnt[1]--;
        cnt[2]--;
        cnt[4]--;
    }
 
    while (cnt[1] && cnt[3] && cnt[6]) {
        ans.push_back({1, 3, 6});
        cnt[1]--;
        cnt[3]--;
        cnt[6]--;
    }
 
    while (cnt[1] && cnt[2] && cnt[6]) {
        ans.push_back({1, 2, 6});
        cnt[1]--;
        cnt[2]--;
        cnt[6]--;
    }
 
    for (int i = 1; i <= 7; i++) {
        if (cnt[i] != 0) {
            cout << -1;
            return 0;
        }
    }
 
    for (auto &v : ans) {
        cout << v[0] << " " << v[1] << " " << v[2] << "\n";
    }
 
    return 0;
}
