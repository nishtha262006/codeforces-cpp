#include<iostream>
#include<set>
#include<string>
using namespace std;
int main(){
    string s;
    cin>>s;
    set<string>st;
    for(int i = 0; i<= s.size();i++){
        for(char ch = 'a'; ch <='z' ; ch++){
            string temp = s;
            temp.insert(temp.begin() + i, ch);
            st.insert(temp);
        }
    }
    cout<< st.size();
    return 0 ;
    
}
