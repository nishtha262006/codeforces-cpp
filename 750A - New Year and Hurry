#include <iostream>
using namespace std;

int main() {
    int n, k;
    cin >> n >> k;

    int total = 0;
    int ans = 0;

    for (int i = 1; i <= n; i++) {
        total += 5 * i;

        if (total + k <= 240)
            ans++;
        else
            break;
    }

    cout << ans;

    return 0;
}
